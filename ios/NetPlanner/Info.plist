<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- The .netplan file type -->
	<key>UTExportedTypeDeclarations</key>
	<array>
		<dict>
			<key>UTTypeIdentifier</key>
			<string>local.netplanner.plan</string>
			<key>UTTypeDescription</key>
			<string>Net Planner Plan</string>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.json</string>
				<string>public.data</string>
			</array>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>netplan</string>
				</array>
				<key>public.mime-type</key>
				<array>
					<string>application/x-netplan+json</string>
				</array>
			</dict>
		</dict>
	</array>
	<!-- netplanner:// links (Control Center buttons, Shortcuts) -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>local.netplanner.links</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>netplanner</string>
			</array>
		</dict>
	</array>
	<!-- Files the app can open from Files / AirDrop / Mail -->
	<key>CFBundleDocumentTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeName</key>
			<string>Net Planner Plan</string>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>LSHandlerRank</key>
			<string>Owner</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>local.netplanner.plan</string>
			</array>
		</dict>
		<dict>
			<key>CFBundleTypeName</key>
			<string>Spreadsheet</string>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>LSHandlerRank</key>
			<string>Alternate</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>org.openxmlformats.spreadsheetml.sheet</string>
				<string>public.comma-separated-values-text</string>
			</array>
		</dict>
	</array>
	<!-- Show the app's Documents folder (NetPlanner.netplan) in the Files app -->
	<key>UIFileSharingEnabled</key>
	<true/>
	<key>LSSupportsOpeningDocumentsInPlace</key>
	<true/>
	<!-- Talk to the Net Planner server on your network over plain http -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsArbitraryLoads</key>
		<true/>
		<key>NSAllowsArbitraryLoadsInWebContent</key>
		<true/>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
	<key>NSLocalNetworkUsageDescription</key>
	<string>Net Planner connects to your Net Planner server, Proxmox and TrueNAS, and checks whether devices on your network are up.</string>
</dict>
</plist>
