[Unit]
Description=Net Planner server
After=network-online.target
Wants=network-online.target

[Service]
WorkingDirectory=/opt/netplanner
ExecStart=/usr/bin/python3 -u /opt/netplanner/netplanner_server.py --no-browser
Environment=NETPLANNER_PORT=8770
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
